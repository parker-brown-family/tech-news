  }
 ],
 "claims": [
  {
   "text": "The total memory footprint is about 20 GB.",
   "who": "Thinking Machines",
   "status": "said",
   "sources": [
    "tm"
   ]
  },
  {
   "text": "It leads every open-weight model under 100 billion parameters on DeepSWE v1.1, at 48.2%.",
   "who": "Thinking Machines",
   "status": "said",
   "sources": [
    "tm"
   ]
  },
  {
   "text": "It trails Qwen3.8-27B on multi-turn chat and on instructions with many constraints, by the maker’s own numbers.",
