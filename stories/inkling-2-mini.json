   "status": "read",
   "sources": [
    "tm"
   ]
  },
  {
   "text": "It was first on Hugging Face’s trending list when we read it.",
   "who": "our reading",
   "status": "counted",
   "sources": [
    "hf"
   ]
  },
  {
   "text": "One developer publishes builds from 3.9 GB to 12.8 GB, for Apple silicon.",
